    "gyeongju-2-days": {
      "title": "慶州二日遊：韓國的千年古都",
      "metaTitle": "慶州二日遊行程（2026）",
      "sub": "新羅古寺、王陵與燈火點綴的池塘——走進韓國古都這座露天博物館。",
      "days": "2",
      "cities": [
        "gyeongju"
      ],
      "overview": "慶州曾是新羅王朝將近千年的都城，各種珍貴古蹟散落在這座悠閒的小城裡。一天走訪山間的UNESCO世界遺產寺廟，另一天則安排市中心一帶的王陵、天文臺與夜間點燈的池塘。從首爾或釜山搭KTX到鄰近的新慶州站也很方便。",
      "plan": [
        {
          "n": 1,
          "area": "UNESCO寺廟與山間巡禮",
          "stops": [
            {
              "t": "上午",
              "p": "佛國寺——新羅時代的石造平臺與石塔傑作；建議一早前往。",
              "spot": "Bulguksa, Gyeongju"
            },
            {
              "t": "下午",
              "p": "沿著同一座山往上走到石窟庵，欣賞莊嚴寧靜的石佛與海景。",
              "spot": "Seokguram, Gyeongju"
            },
            {
              "t": "傍晚",
              "p": "回到市區，在時髦的咖啡與美食街皇理團路一帶享用晚餐。",
              "spot": "Hwangnidan-gil, Gyeongju"
            }
          ]
        },
        {
          "n": 2,
          "area": "王陵、天文臺與池塘",
          "stops": [
            {
              "t": "上午",
              "p": "大陵苑古墳公園與天馬塚——唯一能走進去參觀的王陵。",
              "spot": "Daereungwon, Gyeongju"
            },
            {
              "t": "下午",
              "p": "參觀瞻星臺這座古老的石造天文臺，接著前往國立慶州博物館。",
              "spot": "Cheomseongdae, Gyeongju"
            },
            {
              "t": "傍晚",
              "p": "入夜後造訪東宮與月池，欣賞樓閣倒映在水面的景致。",
              "spot": "Donggung Palace and Wolji Pond, Gyeongju"
            }
          ]
        }
      ],
      "tips": [
        "搭KTX到新慶州站，再轉乘公車或計程車前往各景點。",
        "在市中心租一台單車——王陵、瞻星臺與月池彼此距離都很近。",
        "把月池留到入夜後再去；那是慶州最具代表性的夜景。"
      ]
    }
