          "stops": [
            {
              "t": "上午",
              "p": "甘川洞文化村——山坡上色彩繽紛的社區。",
              "spot": "Gamcheon Culture Village, Busan"
            },
            {
              "t": "下午",
              "p": "南浦洞的札嘎其魚市場與BIFF廣場街頭小吃。",
              "spot": "Jagalchi Market, Busan"
            },
            {
              "t": "晚上",
              "p": "在黃昏時分造訪罕見的海邊寺廟——海東龍宮寺。",
              "spot": "Haedong Yonggungsa, Busan"
            }
          ]
        },
        {
          "n": 5,
          "area": "返回首爾／啟程回家",
          "stops": [
            {
              "t": "上午",
              "p": "把握最後時間去釜山的海灘或咖啡館，再搭KTX回首爾（或從金海機場直接飛回家）。",
              "spot": "Busan Station"
            },
            {
              "t": "下午",
              "p": "若從仁川機場出發，記得預留搭AREX機場快線／前往機場的時間。",
              "spot": "Incheon International Airport"
            }
          ]
        }
      ],
      "tips": [
        "週末與假日請提前訂KTX的座位（Korail Talk App／letskorail.com）。",
        "釜山幅員遼闊——搭地鐵再加上Kakao T計程車，大部分地方都到得了。",
        "首爾住兩晚＋釜山住兩晚，就不用一直打包、拆行李。"
      ]
