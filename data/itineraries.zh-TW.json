    "seoul-3-days": {
      "title": "首爾 3 日遊：初訪者的完美行程",
      "metaTitle": "首爾 3 日遊：完美行程規劃（2026）",
      "sub": "古宮、韓屋巷弄、街頭小吃與城市天際線——輕鬆卻完整的首爾初訪之旅。",
      "days": "3",
      "cities": [
        "seoul"
      ],
      "overview": "這是最經典的初訪路線：第一天走訪古首爾（宮殿與韓屋），第二天感受現代首爾與夜景，第三天則彈性安排一日遊或自己想去的地方。所有景點都有地鐵串連——買張T-money卡就搞定了。",
      "plan": [
        {
          "n": 1,
          "area": "宮殿與古首爾",
          "stops": [
            {
              "t": "上午",
              "p": "景福宮——早點到，穿韓服還能免費入場。別錯過守門將換崗儀式。",
              "spot": "Gyeongbokgung Palace, Seoul"
            },
            {
              "t": "下午",
              "p": "漫步北村韓屋村與三清洞的咖啡館，再到仁寺洞喝茶、逛藝廊、買伴手禮。",
              "spot": "Bukchon Hanok Village, Seoul"
            },
            {
              "t": "晚上",
              "p": "在廣藏市場吃晚餐（綠豆煎餅、麻藥飯捲），這是首爾歷史悠久的街頭美食市場之一。",
              "spot": "Gwangjang Market, Seoul"
            }
          ]
        },
        {
          "n": 2,
          "area": "現代首爾與夜景",
          "stops": [
            {
              "t": "上午",
              "p": "在弘大吃早午餐、逛街——大學周邊有獨立小店、咖啡館與街頭藝人。",
              "spot": "Hongdae, Seoul"
            },
            {
              "t": "下午",
              "p": "前往南山，登上N首爾塔飽覽城市全景；沿途還能走走綠意盎然的步道。",
              "spot": "N Seoul Tower, Seoul"
            },
            {
              "t": "晚上",
              "p": "到明洞購物、逛美妝店，再來第二輪街頭小吃。",
              "spot": "Myeongdong, Seoul"
            }
          ]
        },
        {
          "n": 3,
          "area": "由你決定——一日遊或深度探索",
          "stops": [
            {
              "t": "選項 A",
              "p": "江南：COEX星空圖書館、狎鷗亭的K-Star Road，還有高檔購物。",
              "spot": "Starfield COEX Mall, Seoul"
            },
            {
              "t": "選項 B",
              "p": "半日DMZ非軍事區行程，前往兩韓邊界——記得先預約（需帶護照）。",
              "spot": "Imjingak, Paju"
            },
            {
              "t": "晚上",
              "p": "在漢江公園（汝矣島）放鬆收尾——買些便利商店的零食，看著橋樑點亮燈光。",
              "spot": "Yeouido Hangang Park, Seoul"
            }
          ]
        }
      ],
      "tips": [
        "先辦一張T-money卡——地鐵、公車和大多數計程車都能用。",
        "各宮殿的公休日不同（景福宮：週二）——出發前先確認一下。",
        "查路線請用Naver地圖或KakaoMap；Google Maps在韓國的大眾運輸功能有限。"
      ]
    },
