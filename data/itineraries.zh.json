    "gyeongju-2-days": {
      "title": "庆州两日游：韩国的千年古都",
      "metaTitle": "庆州两日游行程（2026）",
      "sub": "新罗古刹、王陵与灯火映照的池塘——韩国古都这座露天博物馆。",
      "days": "2",
      "cities": [
        "gyeongju"
      ],
      "overview": "庆州曾作为新罗王朝的都城近千年，众多瑰宝散落在这座悠闲的小城各处。一天用来探访山间的UNESCO世界遗产寺庙，另一天则游览市中心一带的古墓、天文台和夜色中的池塘。从首尔或釜山乘KTX即可轻松抵达附近的新庆州站。",
      "plan": [
        {
          "n": 1,
          "area": "UNESCO寺庙与山林",
          "stops": [
            {
              "t": "上午",
              "p": "佛国寺——新罗时代石砌台基与石塔的杰作；建议尽早前往。",
              "spot": "Bulguksa, Gyeongju"
            },
            {
              "t": "下午",
              "p": "沿同一座山上行至石窟庵，庵中安详的石雕佛像与远眺的海景令人难忘。",
              "spot": "Seokguram, Gyeongju"
            },
            {
              "t": "傍晚",
              "p": "返回市区，在时尚的咖啡与美食街皇理团路一带享用晚餐。",
              "spot": "Hwangnidan-gil, Gyeongju"
            }
          ]
        },
        {
          "n": 2,
          "area": "古墓、天文台与池塘",
          "stops": [
            {
              "t": "上午",
              "p": "大陵苑古墓公园，以及唯一可以走进内部的王陵天马冢。",
              "spot": "Daereungwon, Gyeongju"
            },
            {
              "t": "下午",
              "p": "瞻星台——一座古老的石造天文台，随后参观国立庆州博物馆。",
              "spot": "Cheomseongdae, Gyeongju"
            },
            {
              "t": "傍晚",
              "p": "入夜后的东宫与月池，楼阁倒映水中，别有韵味。",
              "spot": "Donggung Palace and Wolji Pond, Gyeongju"
            }
          ]
        }
      ],
      "tips": [
        "乘KTX到新庆州站，再换乘公交或出租车前往各景点。",
        "在市中心租辆自行车——古墓、瞻星台与月池彼此相距不远。",
        "把月池留到天黑后再去；这是庆州的标志性夜景。"
      ]
    },
    "kpop-3-days": {
      "title": "K-pop朝圣之旅：粉丝的首尔3日行程",
      "metaTitle": "首尔K-pop：粉丝3日行程（2026）",
      "sub": "经纪公司街区、KWANGYA@SEOUL旗舰店、爱豆咖啡厅和圣水快闪店——为粉丝量身打造的完美首尔初游。",
      "days": "3",
      "cities": [
        "seoul"
      ],
      "overview": "专为K-pop粉丝设计：第一天逛圣水的咖啡厅与快闪店街区（SM Entertainment总部和KWANGYA@SEOUL门店所在地），第二天走访首尔市中心的经纪公司街区和K-beauty，第三天在弘大一带体验独立小店、舞蹈和街头表演。演唱会和音乐节目的日期经常变动，建议围绕它们来安排固定行程，并在kpophub.kr和官方票务网站查看近期活动。",
      "plan": [
        {
          "n": 1,
          "area": "圣水——K-pop快闪店中心",
          "stops": [
            {
              "t": "上午",
              "p": "从圣水出发，这里是首尔由旧工厂改造的咖啡厅街区，也是SM Entertainment的所在地。到KWANGYA@SEOUL旗舰店选购aespa、NCT、RIIZE等艺人的官方周边。",
              "spot": "KWANGYA@SEOUL, Seoul"
            },
            {
              "t": "下午",
              "p": "在设计感咖啡厅之间穿梭，再看看有哪些K-pop和品牌快闪店、爱豆主题咖啡厅正在营业——它们更换频繁，去之前先查清当下有什么（有些需要预约指定时段）。",
              "spot": "Seongsu-dong, Seoul"
            },
            {
              "t": "晚上",
              "p": "到隔壁的首尔林放松一下，或留在圣水吃晚餐、继续泡咖啡厅。",
              "spot": "Seoul Forest, Seoul"
            }
          ]
        },
        {
          "n": 2,
          "area": "经纪公司、K-beauty与汉江",
          "stops": [
            {
              "t": "上午",
              "p": "前往龙山的HYBE总部一带（BTS等艺人的所属公司），这是粉丝钟爱的打卡点。大楼是正常办公场所，请在外面欣赏。",
              "spot": "HYBE, Yongsan-gu, Seoul"
            },
            {
              "t": "下午",
              "p": "到明洞体验K-beauty和官方周边——化妆品旗舰店、快闪店和街头小吃都集中在步行可达的范围内。",
              "spot": "Myeongdong, Seoul"
            },
            {
              "t": "晚上",
              "p": "如果你有音乐节目现场录制（Inkigayo、M Countdown、Show! Music Core等）的门票，就安排在这个时段——各节目的申请方式和录制场地不同，请提前确认细节。否则，就到汝矣岛享受汉江风光。",
              "spot": "Yeouido Hangang Park, Seoul"
            }
          ]
        },
        {
          "n": 3,
          "area": "弘大——独立、舞蹈与街头表演",
          "stops": [
            {
              "t": "上午",
              "p": "逛弘大：弘益大学周边有独立唱片和周边小店、K-pop舞蹈教室和咖啡厅。",
              "spot": "Hongdae, Seoul"
            },
            {
              "t": "下午",
              "p": "在弘益大学站出口广场附近观看街头表演和「随机舞蹈」活动（自发进行，视天气而定），或参加一堂K-pop舞蹈课。",
              "spot": "Hongik University Station, Seoul"
            },
            {
              "t": "晚上",
              "p": "把晚上留出来看演唱会——很多粉丝正是围绕它来安排整趟旅行。到kpophub.kr和官方票务网站查看最新的巡演和回归日期。",
              "spot": "Hongdae, Seoul"
            }
          ]
        }
      ],
      "tips": [
        "演唱会和音乐节目的日程经常变动——确定行程日期前，先到kpophub.kr和官方票务网站查看。",
        "圣水的快闪店和爱豆咖啡厅会轮换；出发前查清当下有哪些，并记下需要预约指定时段的店。",
        "经纪公司大楼（HYBE、SM、JYP、YG）都是正常办公场所——欣赏外观和官方门店即可，请尊重工作人员和附近居民。",
        "这里的地点都有地铁直达——办一张T-money卡，用Naver Map或KakaoMap导航。"
      ]
    }
  }
