{
  // Cloudflare Worker: static assets + a small AI chat endpoint (/api/chat).
  // `npm run build` produces ./out (static export). Static pages are served
  // directly from the asset store; the Worker only runs for /api/chat and true
  // 404s, so existing page behaviour is unchanged.
  "name": "korea-trip-hub",
  "compatibility_date": "2025-01-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // With not_found_handling set, unmatched paths get the 404 page without
    // invoking the Worker — so every Worker route must be listed here.
    "run_worker_first": ["/", "/api/*"]
  },
  // OPENAI_API_KEY enables GPT-6 Luna through the Responses API.
  // Fallback order: Claude Haiku (ANTHROPIC_API_KEY), then Workers AI.
  "ai": { "binding": "AI" },
  // Plain (non-secret) vars live here so `wrangler deploy` keeps them in sync
  // with the dashboard (a dashboard-only var is dropped on the next deploy).
  "vars": {
    "MAIL_FROM": "Korea Trip Hub <hello@send.ktriphub.com>"
  },
  // Place-report response cache + browse lists + send rate limit (created 2026-11-09).
  "kv_namespaces": [{ "binding": "PLACE_CACHE", "id": "aab7b8664dd84632b2fda61e44b3da73" }]
  // --- Place Report (TourAPI) ---
  // Required secret (otherwise /api/place/* returns 503 not_configured):
  //   wrangler secret put TOURAPI_KEY      # data.go.kr 공공데이터포털 Decoding key
  // Email delivery (/api/place/send) also needs (else 503 not_configured):
  //   wrangler secret put RESEND_API_KEY   # resend.com API key (with a verified sending domain)
  //   MAIL_FROM                            # set in "vars" above (not a secret)
  // PLACE_CACHE KV is bound above (namespace created with:
  //   wrangler kv namespace create PLACE_CACHE)
}
