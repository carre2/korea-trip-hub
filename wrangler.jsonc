{
  // Cloudflare Worker: static assets + a small AI chat endpoint (/api/chat).
  // `npm run build` produces ./out (static export). Static pages are served
  // through ASSETS. HTML requests run through the Worker for language redirects
  // and anonymous delivery diagnostics; large static asset paths bypass it.
  "name": "korea-trip-hub",
  "compatibility_date": "2025-01-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*", "!/_next/*", "!/img/*", "!/video/*"]
  },
  // OPENAI_API_KEY enables GPT-6 Luna through the Responses API.
  // Fallback order: Claude Haiku (ANTHROPIC_API_KEY), then Workers AI.
  "ai": { "binding": "AI" },
  "ratelimits": [{"name":"CHAT_LIMITER","namespace_id":"10017","simple":{"limit":10,"period":60}}],
  "analytics_engine_datasets": [
    { "binding": "LANDING_HEALTH", "dataset": "kth_ad_landing_health" }
  ]
}
