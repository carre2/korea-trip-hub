{
  // Cloudflare Worker: static assets + a small AI chat endpoint (/api/chat).
  // `npm run build` produces ./out (static export). Static pages are served
  // directly from the asset store; the Worker only runs for /api/chat and true
  // 404s, so existing page behaviour is unchanged.
  "name": "korea-trip-hub",
  "compatibility_date": "2025-01-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  // Cloudflare Workers AI is the default chat model (no external key needed).
  // If an ANTHROPIC_API_KEY secret is set, the Worker prefers Claude Haiku.
  "ai": { "binding": "AI" }
}
